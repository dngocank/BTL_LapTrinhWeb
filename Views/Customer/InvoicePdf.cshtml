@model BTL_PTTKYC.Models.InvoiceModel
@{
    Layout = null;
    decimal vatAmount = Math.Round((Model.SubTotal - Model.DiscountAmount) * 0.08m, 0);
    string qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=140x140&data={Uri.EscapeDataString($"https://kittyphone.vn/verify-invoice?id={Model.InvoiceId}&code=INV{Model.InvoiceId:D6}&amount={Model.TotalAmount:N0}")}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hóa Đơn Điện Tử VAT #INV-@Model.InvoiceId.ToString("D6") - KittyPhone</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        @@page {
            size: A4;
            margin: 12mm 15mm;
        }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            font-size: 13px;
        }
        .invoice-box {
            max-width: 850px;
            margin: 25px auto;
            background: #ffffff;
            padding: 35px 40px;
            border-radius: 8px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            position: relative;
        }
        .invoice-header-logo {
            font-size: 26px;
            font-weight: 800;
            color: #dc2626;
            letter-spacing: -0.5px;
        }
        .invoice-title {
            text-align: center;
            font-size: 20px;
            font-weight: 800;
            color: #1e293b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 15px;
            margin-bottom: 5px;
        }
        .stamp-paid {
            position: absolute;
            right: 80px;
            bottom: 120px;
            width: 140px;
            height: 140px;
            border: 3px dashed #dc2626;
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #dc2626;
            transform: rotate(-15deg);
            opacity: 0.85;
            font-weight: 800;
            text-transform: uppercase;
            pointer-events: none;
            line-height: 1.2;
            text-align: center;
        }
        .stamp-paid span {
            font-size: 11px;
            letter-spacing: 1px;
        }
        .stamp-paid strong {
            font-size: 16px;
            letter-spacing: 1.5px;
        }
        .table-invoice th {
            background-color: #f8fafc;
            color: #334155;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            border-bottom: 2px solid #cbd5e1;
        }
        .table-invoice td {
            vertical-align: middle;
            border-bottom: 1px solid #e2e8f0;
        }
        @@media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
            }
            .invoice-box {
                margin: 0 !important;
                padding: 0 !important;
                box-shadow: none !important;
                border: none !important;
                max-width: 100% !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-box">
        <!-- Action Toolbar -->
        <div class="no-print d-flex justify-content-between align-items-center mb-4 p-2 bg-light rounded border">
            <div>
                <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại
                </a>
            </div>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-sm btn-danger fw-bold shadow-sm">
                    <i class="bi bi-printer me-1"></i>In / Tải PDF Hóa Đơn (Ctrl+P)
                </button>
            </div>
        </div>

        <!-- Header -->
        <div class="row align-items-center pb-3 border-bottom">
            <div class="col-7">
                <div class="invoice-header-logo">
                    <i class="bi bi-phone-fill text-danger me-1"></i>KITTYPHONE
                </div>
                <div class="fw-bold text-dark mt-1">CÔNG TY CỔ PHẦN CÔNG NGHỆ BÁN LẺ KITTYPHONE</div>
                <div class="text-muted small">Mã số thuế: <strong>0316888999</strong> | Hotline: <strong>1800 6601</strong></div>
                <div class="text-muted small">Showroom: 123 Thái Hà, Đống Đa, Hà Nội & 456 CMT8, Q.10, TP.HCM</div>
            </div>
            <div class="col-5 text-end">
                <img src="@qrUrl" alt="QR Xác thực Hóa đơn" class="border p-1 rounded bg-white shadow-sm" width="100" height="100" />
                <div class="text-muted small mt-1" style="font-size: 10px;">Quét mã QR để tra cứu hóa đơn gốc</div>
            </div>
        </div>

        <!-- Document Title -->
        <div class="invoice-title">HÓA ĐƠN BÁN HÀNG & BẢO HÀNH ĐIỆN TỬ</div>
        <div class="text-center text-muted small mb-3">
            (Bản thể hiện của hóa đơn điện tử hợp pháp theo chuẩn CQT)
        </div>

        <!-- Meta Info -->
        <div class="row mb-3 p-3 bg-light rounded border">
            <div class="col-6">
                <div><strong>Khách hàng:</strong> @Model.CustomerName</div>
                <div><strong>Số điện thoại:</strong> @Model.CustomerPhone</div>
                <div><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</div>
            </div>
            <div class="col-6 text-end">
                <div><strong>Số hóa đơn:</strong> <span class="badge bg-danger fs-6">#INV-@Model.InvoiceId.ToString("D6")</span></div>
                <div><strong>Ngày lập:</strong> @Model.InvoiceDate.ToString("dd/MM/yyyy HH:mm")</div>
                <div><strong>Hình thức TT:</strong> @Model.PaymentMethodSelected</div>
                <div><strong>Trạng thái:</strong> <span class="fw-bold text-success">@Model.Status</span></div>
            </div>
        </div>

        <!-- Items Table -->
        <table class="table table-invoice mb-3">
            <thead>
                <tr>
                    <th style="width: 50px;" class="text-center">STT</th>
                    <th>Tên Sản Phẩm / Thiết Bị</th>
                    <th class="text-center" style="width: 80px;">ĐVT</th>
                    <th class="text-center" style="width: 80px;">Số Lượng</th>
                    <th class="text-end" style="width: 140px;">Đơn Giá</th>
                    <th class="text-end" style="width: 150px;">Thành Tiền</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var item in Model.Details)
                {
                    <tr>
                        <td class="text-center text-muted">@idx</td>
                        <td>
                            <strong class="text-dark">@item.ProductName</strong>
                            <div class="text-muted small" style="font-size: 11px;">
                                <i class="bi bi-shield-check text-success me-1"></i>Bảo hành chính hãng 12 tháng tại KittyPhone
                            </div>
                        </td>
                        <td class="text-center">Máy</td>
                        <td class="text-center fw-bold">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("N0")đ</td>
                        <td class="text-end fw-bold text-dark">@item.LineTotal.ToString("N0")đ</td>
                    </tr>
                    idx++;
                }
            </tbody>
        </table>

        <!-- Summary & Totals -->
        <div class="row mb-4">
            <div class="col-6">
                <div class="p-3 bg-light rounded border h-100">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle text-primary me-1"></i>Ghi chú & Chính sách bảo hành:</div>
                    <ul class="mb-0 text-muted small ps-3">
                        <li>Bảo hành 1 đổi 1 trong 30 ngày nếu có lỗi từ nhà sản xuất.</li>
                        <li>Được kiểm tra máy và hỗ trợ kỹ thuật trọn đời tại mọi chi nhánh KittyPhone.</li>
                        <li>Hóa đơn điện tử có giá trị thay thế phiếu bảo hành giấy truyền thống.</li>
                    </ul>
                </div>
            </div>
            <div class="col-6">
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Cộng tiền hàng:</span>
                    <span class="fw-bold">@Model.SubTotal.ToString("N0")đ</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between py-1 text-danger">
                        <span>Chiết khấu khuyến mại:</span>
                        <span>-@Model.DiscountAmount.ToString("N0")đ</span>
                    </div>
                }
                @if (Model.ShippingFee > 0)
                {
                    <div class="d-flex justify-content-between py-1 text-muted">
                        <span>Cước vận chuyển:</span>
                        <span>+@Model.ShippingFee.ToString("N0")đ</span>
                    </div>
                }
                <div class="d-flex justify-content-between py-2 border-top border-2 mt-2">
                    <span class="fw-bold fs-5 text-dark">TỔNG THANH TOÁN:</span>
                    <span class="fw-bold fs-5 text-danger">@Model.TotalAmount.ToString("N0")đ</span>
                </div>
                <div class="text-end text-muted small fst-italic">
                    (Đã bao gồm thuế GTGT VAT 8%)
                </div>
            </div>
        </div>

        <!-- Stamp -->
        <div class="stamp-paid">
            <span>KITTYPHONE</span>
            <strong>ĐÃ THANH TOÁN</strong>
            <span>PAID IN FULL</span>
        </div>

        <!-- Signatures -->
        <div class="row text-center mt-5 pt-3">
            <div class="col-4">
                <div class="fw-bold text-dark">NGƯỜI MUA HÀNG</div>
                <div class="text-muted small">(Ký, ghi rõ họ tên)</div>
                <div style="height: 60px;"></div>
                <div class="fw-semibold">@Model.CustomerName</div>
            </div>
            <div class="col-4">
                <div class="fw-bold text-dark">NGƯỜI LẬP HÓA ĐƠN</div>
                <div class="text-muted small">(Ký, ghi rõ họ tên)</div>
                <div style="height: 60px;"></div>
                <div class="fw-semibold">@Model.EmployeeName</div>
            </div>
            <div class="col-4">
                <div class="fw-bold text-dark">ĐẠI DIỆN BÁN HÀNG</div>
                <div class="text-muted small">(Ký điện tử & đóng dấu)</div>
                <div style="height: 60px;"></div>
                <div class="text-danger fw-bold">KITTYPHONE RETAIL</div>
            </div>
        </div>
    </div>
</body>
</html>
