@model List<BTL_PTTKYC.Models.WarrantyTicketModel>
@{
    ViewData["Title"] = "Tracking Tiến Độ Bảo Hành Thiết Bị | KittyPhone";
    var customer = ViewBag.Customer as BTL_PTTKYC.Models.CustomerModel;
    var warrantedDevices = ViewBag.WarrantedDevices as List<BTL_PTTKYC.Models.WarrantyCardModel> ?? new List<BTL_PTTKYC.Models.WarrantyCardModel>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-secondary"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Profile" class="text-secondary">Tài khoản</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tracking Bảo Hành</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 text-white overflow-hidden warranty-hero-banner">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center g-3">
                <div class="col-lg-8">
                    <span class="badge bg-white text-primary rounded-pill px-3 py-1 fw-bold text-uppercase mb-2">
                        <i class="bi bi-shield-check me-1"></i>Trung Tâm Dịch Vụ Khách Hàng KittyCare
                    </span>
                    <h2 class="fw-bold mb-2">Theo Dõi & Tracking Tiến Độ Bảo Hành</h2>
                    <p class="mb-0 text-white-50">
                        Cập nhật thời gian thực từng giai đoạn tiếp nhận, kiểm tra chẩn đoán, linh kiện thay thế và bàn giao máy tận nơi của bạn.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end d-flex flex-wrap gap-2 justify-content-lg-end">
                    <a asp-controller="Technician" asp-action="Lookup" class="btn btn-outline-light rounded-pill fw-bold px-3 py-2 shadow-sm">
                        <i class="bi bi-search me-1"></i>Tra Cứu IMEI
                    </a>
                    <a asp-action="Profile" class="btn btn-warning rounded-pill fw-bold px-3 py-2 shadow-sm text-dark">
                        <i class="bi bi-house-door-fill me-1"></i>Đăng Ký BH Tại Nhà
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- KHỐI NỘI DUNG TĨNH: CHÍNH SÁCH & TIÊU CHUẨN BẢO HÀNH (Chuẩn 24hStore) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden warranty-policy-card">
        <div class="card-header bg-white border-bottom p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="warranty-policy-badge-icon">
                            <i class="bi bi-shield-fill-check"></i>
                        </span>
                        <h5 class="fw-bold text-dark mb-0">Chính Sách & Tiêu Chuẩn Bảo Hành Chính Hãng</h5>
                    </div>
                    <p class="text-muted small mb-0">
                        Áp dụng tại chuỗi trung tâm kỹ thuật KittyCare trên toàn quốc theo chuẩn nhà sản xuất Apple, Samsung, Xiaomi.
                    </p>
                </div>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-patch-check-fill me-1 text-primary"></i>Cam Kết Chất Lượng 5 Sao
                </span>
            </div>
        </div>
        <div class="card-body p-4 bg-light-subtle">
            <div class="row g-4">
                <!-- Cột 1: 1 Đổi 1 trong vòng 30 ngày -->
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 rounded-3 shadow-xs p-3 warranty-box warranty-box-primary bg-white">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="warranty-box-icon bg-primary text-white">
                                <i class="bi bi-arrow-repeat"></i>
                            </div>
                            <div>
                                <span class="badge bg-danger-subtle text-danger fw-bold rounded-pill mb-1">30 Ngày Đầu Tiên</span>
                                <h6 class="fw-bold text-dark mb-0">Chính Sách 1 Đổi 1</h6>
                            </div>
                        </div>
                        <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-2">
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                                <span><strong>1 đổi 1 ngay lập tức</strong> trong vòng 30 ngày kể từ ngày mua máy đối với các lỗi phần cứng từ nhà sản xuất.</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                                <span>Áp dụng cho các lỗi: Mất nguồn, màn hình sọc/điểm chết cảm ứng, bo mạch chủ (Mainboard), lỗi camera và loa.</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                                <span>Đổi máy tương đương cùng dòng, cùng màu, không trừ khấu hao và hỗ trợ bảo lưu toàn bộ ưu đãi trước đó.</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Cột 2: Bảo hành chính hãng 12 tháng -->
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 rounded-3 shadow-xs p-3 warranty-box warranty-box-success bg-white">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="warranty-box-icon bg-success text-white">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div>
                                <span class="badge bg-success-subtle text-success fw-bold rounded-pill mb-1">Toàn Diện 12 Tháng</span>
                                <h6 class="fw-bold text-dark mb-0">Bảo Hành Chính Hãng</h6>
                            </div>
                        </div>
                        <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-2">
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                                <span><strong>Cam kết bảo hành toàn diện 12 tháng</strong> đối với tất cả thiết bị di động chính hãng bán ra tại hệ thống.</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                                <span>Sử dụng <strong>100% linh kiện chính hãng</strong> mới tinh nguyên seal, đạt quy chuẩn kiểm định nghiêm ngặt.</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
                                <span>Miễn phí 100% chi phí kiểm tra chẩn đoán lỗi, vệ sinh máy và cập nhật hệ điều hành trọn đời máy.</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Cột 3: Quy định tiếp nhận và Các trường hợp từ chối bảo hành -->
                <div class="col-lg-4 col-md-12">
                    <div class="card h-100 border-0 rounded-3 shadow-xs p-3 warranty-box warranty-box-danger bg-white">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="warranty-box-icon bg-danger text-white">
                                <i class="bi bi-exclamation-octagon-fill"></i>
                            </div>
                            <div>
                                <span class="badge bg-danger-subtle text-danger fw-bold rounded-pill mb-1">Quy Định & Điều Kiện</span>
                                <h6 class="fw-bold text-dark mb-0">Điều Kiện & Từ Chối BH</h6>
                            </div>
                        </div>
                        <div class="small text-secondary mb-2">
                            <div class="fw-bold text-dark mb-1 d-flex align-items-center gap-1">
                                <i class="bi bi-check2-circle text-primary"></i>Quy định tiếp nhận:
                            </div>
                            <p class="mb-2 text-muted warranty-rule-text">
                                Máy có số IMEI/Serial hợp lệ trong hệ thống. Khách hàng vui lòng thoát tài khoản bảo mật (iCloud, Google, Mi Account) trước khi bàn giao.
                            </p>
                        </div>
                        <div class="small text-secondary">
                            <div class="fw-bold text-danger mb-1 d-flex align-items-center gap-1">
                                <i class="bi bi-x-circle-fill text-danger"></i>Trường hợp từ chối bảo hành:
                            </div>
                            <ul class="list-unstyled mb-0 d-flex flex-column gap-1 text-muted warranty-rule-text">
                                <li class="d-flex align-items-start gap-1">
                                    <span class="text-danger fw-bold">•</span>
                                    <span>Vào nước, ngấm chất lỏng, ẩm mốc (quỳ tím bên trong máy đổi màu).</span>
                                </li>
                                <li class="d-flex align-items-start gap-1">
                                    <span class="text-danger fw-bold">•</span>
                                    <span>Rơi vỡ, nứt kính, sọc đốm do va đập, biến dạng cơ học cong vênh sườn vỏ.</span>
                                </li>
                                <li class="d-flex align-items-start gap-1">
                                    <span class="text-danger fw-bold">•</span>
                                    <span>Tự ý cạy mở, sửa chữa bên ngoài hoặc can thiệp phần mềm bên thứ 3 (Root, Jailbreak, Unlock Bootloader).</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer liên hệ CSKH -->
            <div class="mt-3 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2 small text-muted">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-headset text-primary fs-6"></i>
                    <span>Tổng đài hỗ trợ kỹ thuật & khiếu nại bảo hành: <strong class="text-dark">1900.6789</strong> (8:00 - 21:30 hàng ngày)</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span><i class="bi bi-truck text-success me-1"></i>Hỗ trợ nhận trả máy tận nơi toàn quốc</span>
                    <span><i class="bi bi-clock-history text-primary me-1"></i>Thời gian xử lý nhanh chóng 24h - 48h</span>
                </div>
            </div>
        </div>
    </div>

    <!-- KHỐI: THIẾT BỊ CỦA BẠN ĐANG ĐƯỢC BẢO HÀNH (SỔ BẢO HÀNH ĐIỆN TỬ CHÍNH HÃNG) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden warranted-devices-card">
        <div class="card-header bg-white border-bottom p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-3">
                    <span class="warranty-section-icon bg-success-subtle text-success">
                        <i class="bi bi-phone-fill"></i>
                    </span>
                    <div>
                        <h5 class="fw-bold text-dark mb-0">Thiết Bị Của Bạn Đang Được Bảo Hành</h5>
                        <p class="text-muted small mb-0">
                            Sổ bảo hành điện tử chính hãng 12 tháng liên kết theo IMEI/Serial của các thiết bị bạn đã sở hữu
                        </p>
                    </div>
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-patch-check-fill me-1"></i>Đã kích hoạt: @warrantedDevices.Count thiết bị
                </span>
            </div>
        </div>
        <div class="card-body p-4 bg-light-subtle">
            @if (warrantedDevices.Count == 0)
            {
                <div class="text-center py-4 bg-white rounded-3 border p-3">
                    <i class="bi bi-phone-vibrate display-6 text-muted mb-2 d-block"></i>
                    <h6 class="fw-bold text-dark mb-1">Chưa có thiết bị nào được kích hoạt sổ bảo hành</h6>
                    <p class="small text-muted mb-3">Sổ bảo hành điện tử 12 tháng sẽ tự động hiển thị tại đây sau khi bạn đặt mua thiết bị và đơn hàng được giao thành công.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
                        <i class="bi bi-bag me-1"></i>Khám phá sản phẩm KittyPhone
                    </a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var dev in warrantedDevices)
                    {
                        <div class="col-lg-6">
                            <div class="card h-100 border-0 rounded-3 shadow-xs p-3 bg-white warranted-device-item">
                                <div class="d-flex align-items-start gap-3">
                                    <img src="@(string.IsNullOrEmpty(dev.ImageUrl) ? "https://placehold.co/120x120?text=Phone" : dev.ImageUrl)"
                                         alt="@dev.ProductName"
                                         class="warranted-device-img rounded-3 border p-1" />
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-1 mb-1">
                                            <span class="badge bg-primary-subtle text-primary rounded-pill small fw-bold">@dev.BrandName</span>
                                            <span class="@dev.StatusBadgeClass rounded-pill px-2 py-1 small">
                                                <i class="bi @(dev.IsExpired ? "bi-x-circle" : "bi-check-circle-fill") me-1"></i>@dev.StatusBadgeText
                                            </span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">@dev.ProductName</h6>
                                        <div class="small text-muted font-monospace mb-2">
                                            <i class="bi bi-upc-scan me-1 text-primary"></i>IMEI: <strong class="text-dark">@(string.IsNullOrEmpty(dev.ImeiNumber) ? "Đang cập nhật" : dev.ImeiNumber)</strong>
                                            @if (!string.IsNullOrEmpty(dev.SerialNumber))
                                            {
                                                <span class="ms-2">| Serial: <strong>@dev.SerialNumber</strong></span>
                                            }
                                        </div>
                                        <div class="row g-2 small border-top pt-2 mt-1">
                                            <div class="col-6">
                                                <span class="text-muted d-block">Ngày mua máy:</span>
                                                <strong class="text-dark">@dev.PurchaseDate.ToString("dd/MM/yyyy")</strong>
                                            </div>
                                            <div class="col-6">
                                                <span class="text-muted d-block">Hạn BH (12 Tháng):</span>
                                                <strong class="@(dev.IsExpired ? "text-danger" : "text-success")">@dev.WarrantyEnd.ToString("dd/MM/yyyy")</strong>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                                            <a asp-controller="Technician" asp-action="Lookup" asp-route-query="@(dev.ImeiNumber ?? dev.SerialNumber)" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-1 small">
                                                <i class="bi bi-search me-1"></i>Tra cứu chi tiết
                                            </a>
                                            <a asp-action="Profile" class="btn btn-outline-primary btn-sm rounded-pill px-2 py-1 small fw-bold">
                                                <i class="bi bi-tools me-1"></i>Đăng ký BH tận nhà
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- DANH SÁCH PHIẾU BẢO HÀNH (TỐI ƯU UX) -->
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <span class="warranty-section-icon bg-primary-subtle text-primary">
                    <i class="bi bi-card-checklist"></i>
                </span>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Danh Sách Phiếu Tiếp Nhận Bảo Hành & Sửa Chữa</h5>
                    <span class="badge bg-primary rounded-pill px-2 py-1 mt-1 small">Tổng số: @Model.Count phiếu</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Technician" asp-action="Lookup" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 fw-bold d-flex align-items-center gap-1 shadow-xs warranty-imei-btn">
                    <i class="bi bi-upc-scan fs-6"></i>
                    <span>Tra Cứu Thời Hạn Bảo Hành Theo IMEI</span>
                    <i class="bi bi-arrow-right-short fs-5"></i>
                </a>
            </div>
        </div>

        <!-- Subtext Giải Thích Rõ Cho Khách Hàng -->
        <div class="alert alert-info border-0 rounded-3 mb-4 d-flex align-items-start gap-3 p-3 warranty-subtext-alert">
            <i class="bi bi-info-circle-fill text-primary fs-4 flex-shrink-0 mt-1"></i>
            <div class="small">
                <strong class="text-dark d-block mb-1">Lưu ý về danh sách phiếu:</strong>
                <span class="text-secondary">
                    Đây là danh sách các <strong>"Phiếu tiếp nhận sửa chữa/kỹ thuật"</strong> được nhân viên KittyCare lập khi bạn gửi máy trực tiếp tới hệ thống cửa hàng hoặc đăng ký hỗ trợ tiếp nhận bảo hành tại nhà. 
                    Mỗi phiếu cho phép bạn theo dõi trực tuyến tiến độ kiểm tra chẩn đoán, báo giá linh kiện thay thế và ngày hẹn hoàn tất bàn giao.
                </span>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted border rounded-3 bg-light">
                <i class="bi bi-shield-slash display-5 d-block mb-3 text-secondary"></i>
                <h6 class="fw-bold text-dark">Bạn chưa có phiếu tiếp nhận bảo hành nào</h6>
                <p class="small text-muted mb-3">Đăng ký dịch vụ tiếp nhận bảo hành tận nhà để kỹ thuật viên hoặc bưu tá tới nhận máy tận nơi tiện lợi, hoặc tra cứu hạn bảo hành máy đang dùng.</p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-action="Profile" class="btn btn-primary rounded-pill btn-sm px-4 fw-bold">
                        <i class="bi bi-plus-circle me-1"></i>Đăng Ký Bảo Hành Tận Nhà
                    </a>
                    <a asp-controller="Technician" asp-action="Lookup" class="btn btn-outline-secondary rounded-pill btn-sm px-3 fw-bold">
                        <i class="bi bi-search me-1"></i>Tra Cứu Theo IMEI
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var t in Model)
                {
                    <div class="card rounded-3 p-3 shadow-xs bg-white warranty-card-item">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-primary font-monospace fs-6">#@t.TicketCode</span>
                                <span class="badge @t.StatusBadgeClass rounded-pill px-2 py-1 small">@t.StatusVietnamese</span>
                                @if (t.IsHomeService)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small">
                                        <i class="bi bi-house-door-fill me-1"></i>Bảo Hành Tận Nhà (@t.ShippingCarrier)
                                    </span>
                                }
                            </div>
                            <div class="small text-muted">
                                Tiếp nhận: @t.ReceiveDate.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div class="row g-3 py-3 align-items-center">
                            <div class="col-md-7">
                                <h6 class="fw-bold text-dark mb-1">@(t.ProductName ?? "Điện thoại / Thiết bị di động")</h6>
                                @if (!string.IsNullOrEmpty(t.ImeiNumber))
                                {
                                    <div class="small text-muted font-monospace mb-1">IMEI: @t.ImeiNumber</div>
                                }
                                <div class="small text-danger">
                                    <strong>Lỗi khách báo:</strong> @t.CustomerIssue
                                </div>
                                @if (!string.IsNullOrEmpty(t.Diagnosis))
                                {
                                    <div class="small text-primary mt-1">
                                        <strong>Chẩn đoán KTV:</strong> @t.Diagnosis
                                    </div>
                                }
                            </div>

                            <div class="col-md-5 text-md-end">
                                <div class="small text-muted mb-1">Chi phí sửa chữa:</div>
                                <div class="fw-bold text-dark fs-5 mb-1">
                                    @(t.RepairCost == 0 ? "0đ (Miễn phí BH)" : t.RepairCost.ToString("N0") + "đ")
                                </div>
                                <span class="@t.PaymentStatusBadgeClass px-2 py-1 rounded-pill small">
                                    @t.PaymentStatusVietnamese
                                </span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <div class="small text-muted">
                                <i class="bi bi-person-gear me-1"></i>KTV phụ trách: <strong>@(t.TechnicianName ?? "Nguyễn Văn Kỹ Thuật")</strong>
                            </div>
                            <a asp-action="WarrantyDetail" asp-route-id="@t.TicketId" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
                                Xem Chi Tiết & Timeline <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
