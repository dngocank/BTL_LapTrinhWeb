                <span class="small text-muted"><i class="bi bi-telephone-fill text-danger me-1"></i>Tư vấn định giá trực tiếp: <strong>0396166509</strong></span>
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     MODAL 3: SIÊU DEAL KHUYẾN MÃI HOT - GIỜ VÀNG GIẢM SÂU
     ======================================================== -->
<div class="modal fade" id="modalHotDeals" tabindex="-1" aria-labelledby="modalHotDealsLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Modal Header -->
            <div class="modal-header border-0 text-white p-3 p-md-4" style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);">
                <div>
                    <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2">
                        <i class="bi bi-lightning-charge-fill me-1 text-danger"></i>FLASH SALE HÔM NAY
                    </span>
                    <h4 class="modal-title fw-bold text-white mb-1" id="modalHotDealsLabel">
