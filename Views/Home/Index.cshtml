                <!-- Active Promotion Vouchers -->
                @if (promotions.Count > 0)
                {
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-ticket-perforated-fill text-danger me-1"></i>Voucher Giờ Vàng Khuyến Mãi Đang Kích Hoạt:</h6>
                        <div class="row g-2">
                            @foreach (var promo in promotions.Take(3))
                            {
                                <div class="col-md-4">
                                    <div class="p-3 bg-white rounded-3 border d-flex align-items-center justify-content-between shadow-sm" style="border-left: 4px solid #dc2626 !important;">
                                        <div>
                                            <span class="badge bg-danger text-white fw-bold mb-1">GIẢM @promo.DiscountPercent.ToString("0.#")%</span>
                                            <div class="fw-bold small text-dark">@promo.PromotionName</div>
                                            <div class="text-muted" style="font-size: 11px;">@promo.Description</div>
                                        </div>
                                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Top Hot Deal Products Grid -->
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-stars text-primary me-1"></i>Sản phẩm Deal Hot giảm giá mạnh nhất:</h6>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-3">
                    @if (hotDeals.Any())
                    {
                        foreach (var d in hotDeals)
                        {
                            <div class="col">
                                <div class="product-card-cps h-100 bg-white shadow-sm p-3 rounded-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="cps-badge-discount">Giảm @(d.DiscountPercent > 0 ? d.DiscountPercent : 15)%</span>
                                        <span class="cps-badge-installment">Trả góp 0%</span>
                                    </div>

                                    <div class="text-center my-2">
                                        <a asp-controller="Home" asp-action="Detail" asp-route-id="@d.ProductId">
                                            <img src="@(string.IsNullOrEmpty(d.ImageUrl) ? "/images/placeholder-phone.svg" : d.ImageUrl)" 
                                                 alt="@d.ProductName" 
                                                 class="img-fluid" 
                                                 style="height: 120px; object-fit: contain;" 
                                                 onerror="this.onerror=null;this.src='/images/placeholder-phone.svg';" />
                                        </a>
                                    </div>

                                    <h6 class="cps-card-title mb-2">
                                        <a asp-controller="Home" asp-action="Detail" asp-route-id="@d.ProductId" class="text-dark text-decoration-none fw-bold" title="@d.ProductName">
                                            @d.ProductName
                                        </a>
                                    </h6>

                                    <div class="cps-card-price-row mb-2">
                                        <span class="cps-card-price-current">@d.SellingPrice.ToString("N0")đ</span>
                                        <span class="cps-card-price-old">@((d.SellingPrice + (d.DiscountAmount > 0 ? d.DiscountAmount : d.SellingPrice * 0.15m)).ToString("N0"))đ</span>
                                    </div>

                                    <div class="small text-muted mb-3">
                                        <i class="bi bi-gift-fill text-danger me-1"></i>Trợ giá 2.5Tr • Tặng phụ kiện
                                    </div>

                                    <div class="mt-auto d-flex gap-2">
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-grow-1">
                                            <input type="hidden" name="productId" value="@d.ProductId" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <input type="hidden" name="buyNow" value="true" />
                                            <button type="submit" class="btn btn-sm btn-danger w-100 rounded-pill fw-semibold">
                                                <i class="bi bi-cart-plus me-1"></i>Mua ngay
                                            </button>
                                        </form>
                                        <a asp-controller="Home" asp-action="Detail" asp-route-id="@d.ProductId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            Chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0 bg-white p-3 d-flex justify-content-between">
                <a asp-action="Index" asp-route-sort="discount" asp-fragment="productCatalog" class="btn btn-outline-danger rounded-pill px-3" data-bs-dismiss="modal">
                    <i class="bi bi-grid-3x3-gap me-1"></i>Xem tất cả Deal tại Danh mục
                </a>
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

