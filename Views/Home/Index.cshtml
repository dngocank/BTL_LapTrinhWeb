@model List<BTL_PTTKYC.Models.ProductViewModel>
@{
    ViewData["Title"] = "KittyPhone - Điện thoại, máy tính bảng, phụ kiện chính hãng";
    var brands = ViewBag.Brands as List<(int id, string name)> ?? new();
    var categories = ViewBag.Categories as List<(int id, string name)> ?? new();
    var promotions = ViewBag.Promotions as List<BTL_PTTKYC.Models.PromotionModel> ?? new();
    int? currentBrandId = ViewBag.CurrentBrandId as int?;
    int? currentCategoryId = ViewBag.CurrentCategoryId as int?;
    string? currentKeyword = ViewBag.CurrentKeyword as string;
    string? currentSeries = ViewBag.CurrentSeries as string;
    string? currentPriceRange = ViewBag.CurrentPriceRange as string;
    string currentSort = ViewBag.CurrentSort as string ?? "hot";

    var preorderDuo = ViewBag.PreorderDuo as List<BTL_PTTKYC.Models.ProductViewModel> ?? new();
    var preorder18 = ViewBag.Preorder18 as List<BTL_PTTKYC.Models.ProductViewModel> ?? new();
    var hotDeals = ViewBag.HotDeals as List<BTL_PTTKYC.Models.ProductViewModel> ?? new();
    var tradeInProducts = ViewBag.TradeInProducts as List<BTL_PTTKYC.Models.ProductViewModel> ?? new();

    // Cấu hình biến thể / dòng máy riêng biệt cho từng danh mục
    var categorySubFilters = new Dictionary<int, (string AllLabel, List<(string Label, string Query)> Items)>
    {
        // 0. Tất cả danh mục
        [0] = ("Tất cả dòng máy", new List<(string, string)> {
            ("iPhone Duo & 18", "iPhone 18"),
            ("iPhone 16 Series", "iPhone 16"),
            ("Galaxy S25 Ultra", "Galaxy S25"),
            ("Galaxy Z Fold & Flip", "Galaxy Z"),
            ("iPad Pro & Air", "iPad"),
            ("Apple Watch", "Apple Watch"),
            ("AirPods", "AirPods"),
            ("Củ & Cáp sạc", "sạc"),
            ("Ốp lưng", "Ốp lưng")
        }),

        // 1. Điện thoại (CategoryId = 1)
        [1] = ("Tất cả điện thoại", new List<(string, string)> {
            ("iPhone Duo", "iPhone Duo"),
            ("iPhone 18 Series", "iPhone 18"),
            ("iPhone 17 Series", "iPhone 17"),
            ("iPhone 16 Series", "iPhone 16"),
            ("iPhone 15 Series", "iPhone 15"),
            ("iPhone 14 Series", "iPhone 14"),
            ("iPhone 13 Series", "iPhone 13"),
            ("Galaxy S25 Series", "Galaxy S25"),
            ("Galaxy Z Fold & Flip", "Galaxy Z"),
            ("Galaxy A Series", "Galaxy A"),
            ("Xiaomi Series", "Xiaomi"),
            ("OPPO Series", "OPPO"),
            ("Vivo Series", "Vivo")
        }),

        // 2. Máy tính bảng (CategoryId = 2)
        [2] = ("Tất cả máy tính bảng", new List<(string, string)> {
            ("iPad Pro M4", "iPad Pro"),
            ("iPad Air M2", "iPad Air"),
            ("iPad mini 7", "iPad mini"),
            ("iPad A16 (2025)", "iPad A16"),
            ("Galaxy Tab S10", "Tab S"),
            ("Galaxy Tab A11", "Tab A"),
            ("Xiaomi Pad / Redmi Pad", "Pad")
        }),

        // 4. Đồng hồ thông minh (CategoryId = 4)
        [4] = ("Tất cả đồng hồ", new List<(string, string)> {
            ("Apple Watch Series 10", "Series 10"),
            ("Apple Watch Ultra 2", "Ultra 2"),
            ("Apple Watch SE 3", "SE 3"),
            ("Galaxy Watch 7", "Galaxy Watch")
        }),

        // 3. Tai nghe & Phụ kiện (CategoryId = 3)
        [3] = ("Tất cả phụ kiện", new List<(string, string)> {
            ("Tai nghe AirPods", "AirPods"),
            ("Tai nghe Baseus", "Baseus"),
            ("Tai nghe Havit", "Havit"),
            ("Củ sạc nhanh Apple", "Củ sạc"),
            ("Cáp sạc Type-C", "Cáp sạc"),
            ("Ốp lưng MagSafe", "Ốp lưng"),
            ("Bút Apple Pencil", "Apple Pencil"),
            ("Bàn phím Magic Keyboard", "Magic Keyboard")
        })
    };

    int effectiveCatId = (currentCategoryId == 5) ? 3 : (currentCategoryId ?? 0);
    var currentFilterConfig = categorySubFilters.ContainsKey(effectiveCatId) 
        ? categorySubFilters[effectiveCatId] 
        : categorySubFilters[0];

    // Hot Sale Deals
    var hotSaleProducts = Model.Where(p => 
        p.ProductName.Contains("Galaxy Tab A11") || 
        p.ProductName.Contains("Redmi Pad 2") || 
        p.ProductName.Contains("Galaxy A17") || 
        p.ProductName.Contains("Apple Watch SE 3") || 
        p.ProductName.Contains("iPad A16")
    ).Take(5).ToList();

    if (hotSaleProducts.Count < 3)
    {
        hotSaleProducts = Model.Take(5).ToList();
    }

    // Flagship iPhones & Foldables
    var flagshipProducts = Model.Where(p => 
        p.ProductName.Contains("iPhone 18 Pro Max") || 
        p.ProductName.Contains("iPhone 18 Pro 1TB") || 
        p.ProductName.Contains("iPhone Duo 256GB") ||
        p.ProductName.Contains("Galaxy S25 Ultra")
    ).Take(4).ToList();

    if (flagshipProducts.Count < 2)
    {
        flagshipProducts = Model.Where(p => p.CategoryId == 1).Take(4).ToList();
    }

    var stagePhones = Model.Where(p => p.CategoryId == 1 || p.CategoryId == 4).Take(8).ToList();
    var stageTablets = Model.Where(p => p.CategoryId == 2).Take(8).ToList();
    var stageSounds = Model.Where(p => p.CategoryId == 3 || p.CategoryId == 5).Take(8).ToList();
    var stageApples = Model.Where(p => (p.ProductName != null && (p.ProductName.Contains("iPhone", StringComparison.OrdinalIgnoreCase) || 
                                       p.ProductName.Contains("iPad", StringComparison.OrdinalIgnoreCase) || 
                                       p.ProductName.Contains("Apple", StringComparison.OrdinalIgnoreCase) || 
                                       p.ProductName.Contains("AirPods", StringComparison.OrdinalIgnoreCase))) || 
                                       (p.BrandName != null && p.BrandName.Contains("Apple", StringComparison.OrdinalIgnoreCase))).Take(8).ToList();

    var stageProducts = stagePhones.Union(stageTablets).Union(stageSounds).Union(stageApples).DistinctBy(p => p.ProductId).ToList();
    if (!stageProducts.Any())
    {
        stageProducts = Model.Take(20).ToList();
    }

    var bannerIphone = Model.FirstOrDefault(p => p.ProductName.Contains("iPhone 18 Pro Max")) 
                    ?? Model.FirstOrDefault(p => p.ProductName.Contains("iPhone 18"))
                    ?? Model.FirstOrDefault(p => p.CategoryId == 1);

    var bannerS25 = Model.FirstOrDefault(p => p.ProductName.Contains("Galaxy S25 Ultra")) 
                 ?? Model.FirstOrDefault(p => p.ProductName.Contains("Galaxy S25"))
                 ?? Model.FirstOrDefault(p => p.BrandName == "Samsung");

    bool isFilterActive = currentCategoryId != null || 
                          currentBrandId != null || 
                          !string.IsNullOrEmpty(currentSeries) || 
                          !string.IsNullOrEmpty(currentKeyword) || 
                          (!string.IsNullOrEmpty(currentPriceRange) && currentPriceRange != "all");

    string categoryTitle = "Danh Sách Sản Phẩm Nổi Bật";
    if (currentCategoryId == 1) categoryTitle = "Điện thoại chính hãng";
    else if (currentCategoryId == 2) categoryTitle = "Máy tính bảng chính hãng";
    else if (currentCategoryId == 4) categoryTitle = "Đồng hồ thông minh & Smartwatch";
    else if (currentCategoryId == 3) categoryTitle = "Tai nghe & Phụ kiện cao cấp";
    else if (!string.IsNullOrEmpty(currentKeyword)) categoryTitle = $"Kết quả tìm kiếm: \"{currentKeyword}\"";
    else if (currentBrandId != null)
    {
        var b = brands.FirstOrDefault(x => x.id == currentBrandId);
        categoryTitle = $"Sản phẩm {b.name ?? "thương hiệu"}";
    }
}

<div class="container py-3">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Lỗi CSDL:</strong> @ViewBag.ErrorMessage
        </div>
    }

    @if (isFilterActive)
    {
        <!-- Breadcrumb Navigation for Category / Filtered View -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb py-2 px-3 bg-white rounded-3 border shadow-sm align-items-center mb-0" style="font-size: 13px;">
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="text-decoration-none text-muted">
                        <i class="bi bi-house-door-fill me-1"></i>Trang chủ
                    </a>
                </li>
                @if (currentCategoryId != null)
                {
                    <li class="breadcrumb-item @(string.IsNullOrEmpty(currentSeries) ? "active text-danger fw-bold" : "")">
                        @if (!string.IsNullOrEmpty(currentSeries))
                        {
                            <a asp-action="Index" asp-route-categoryId="@currentCategoryId" class="text-decoration-none text-danger fw-semibold">@categoryTitle</a>
                        }
                        else
                        {
                            <span>@categoryTitle</span>
                        }
                    </li>
                }
                @if (!string.IsNullOrEmpty(currentSeries))
                {
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">@currentSeries</li>
                }
                @if (!string.IsNullOrEmpty(currentKeyword))
                {
                    <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">Tìm kiếm: "@currentKeyword"</li>
                }
            </ol>
        </nav>
    }

    @if (!isFilterActive)
    {
    <!-- ========================================================
         1. KITTYPHONE HERO SECTION (Category Menu + Slider + Banners)
         ======================================================== -->
    <div class="cps-hero-grid mb-4">
        <!-- Left: Category Sidebar Menu -->
        <div class="cps-sidebar-menu d-none d-lg-block">
            <ul class="cps-sidebar-list list-unstyled mb-0">
                <li>
                    <a asp-action="Index" asp-route-categoryId="1" class="cps-sidebar-link @(currentCategoryId == 1 ? "active" : "")">
                        <i class="bi bi-phone text-danger"></i>
                        <span>Điện thoại</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-route-categoryId="2" class="cps-sidebar-link @(currentCategoryId == 2 ? "active" : "")">
                        <i class="bi bi-tablet text-primary"></i>
                        <span>Máy tính bảng</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-route-categoryId="4" class="cps-sidebar-link @(currentCategoryId == 4 ? "active" : "")">
                        <i class="bi bi-smartwatch text-warning"></i>
                        <span>Đồng hồ, Camera</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-route-categoryId="3" class="cps-sidebar-link @(currentCategoryId == 3 ? "active" : "")">
                        <i class="bi bi-headphones text-info"></i>
                        <span>Tai nghe, Loa</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-route-categoryId="3" class="cps-sidebar-link @(currentCategoryId == 3 ? "active" : "")">
                        <i class="bi bi-plug text-success"></i>
                        <span>Phụ kiện chính hãng</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-route-series="iPhone 18" class="cps-sidebar-link">
                        <i class="bi bi-apple text-dark"></i>
                        <span>Apple Authorized</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>
                </li>
                <li>
                    <a asp-action="Index" asp-route-brandId="2" class="cps-sidebar-link">
                        <i class="bi bi-stars text-primary"></i>
                        <span>Samsung Galaxy AI</span>
                        <i class="bi bi-chevron-right ms-auto"></i>
                    </a>
                </li>
                <li>
                    <button type="button" class="cps-sidebar-link text-danger fw-semibold" data-bs-toggle="modal" data-bs-target="#modalTradeIn">
                        <i class="bi bi-arrow-repeat text-danger"></i>
                        <span>Thu cũ đổi mới</span>
                        <span class="badge bg-danger-subtle text-danger ms-auto" style="font-size: 0.65rem;">+2.5Tr</span>
                    </button>
                </li>
                <li>
                    <button type="button" class="cps-sidebar-link text-danger fw-semibold" data-bs-toggle="modal" data-bs-target="#modalHotDeals">
                        <i class="bi bi-fire text-danger"></i>
                        <span>Khuyến mãi Hot</span>
                        <span class="badge bg-danger text-white ms-auto" style="font-size: 0.65rem;">HOT</span>
                    </button>
                </li>
            </ul>
        </div>

        <!-- Middle: Big Slider Carousel with Phone Mockup Showcase -->
        <div class="cps-hero-slider">
            <div id="cpsMainCarousel" class="carousel slide h-100" data-bs-ride="carousel" data-bs-interval="4500">
                <!-- Carousel Indicators (Dots) -->
                <div class="carousel-indicators mb-2">
                    <button type="button" data-bs-target="#cpsMainCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#cpsMainCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                </div>

                <div class="carousel-inner h-100 rounded-3">
                    <!-- Slide 1: iPhone 18 Pro Max & iPhone Duo -->
                    <div class="carousel-item active h-100">
                        <div class="cps-slider-banner cps-banner-slide-1 p-4 text-white">
                            <div class="cps-banner-content">
                                <span class="badge bg-white text-primary px-3 py-1 fw-bold rounded-pill mb-2 shadow-sm">
                                    <i class="bi bi-clock-history me-1 text-danger"></i>HẸN SAO - GIAO VẬY
                                </span>
                                <h2 class="display-6 fw-bold mb-2 text-white banner-heading">
                                    iPhone 18 Pro Max <br class="d-none d-md-inline" />&amp; iPhone Duo
                                </h2>
                                <p class="text-white-50 mb-3 banner-desc">
                                    Bản lề Titan tương lai - Màn hình OLED ProMotion kép - Chip A20 Pro 2nm siêu mạnh mẽ
                                </p>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge bg-white bg-opacity-10 border border-white border-opacity-25 px-2 py-1 text-white">
                                        <i class="bi bi-cpu me-1 text-info"></i>A20 Pro 2nm
                                    </span>
                                    <span class="badge bg-white bg-opacity-10 border border-white border-opacity-25 px-2 py-1 text-white">
                                        <i class="bi bi-camera me-1 text-warning"></i>Camera Zoom 10x
                                    </span>
                                    <span class="badge bg-white bg-opacity-10 border border-white border-opacity-25 px-2 py-1 text-white">
                                        <i class="bi bi-stars me-1 text-info"></i>Apple Intelligence
                                    </span>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-controller="Home" asp-action="Detail" asp-route-id="@(bannerIphone?.ProductId ?? 1)" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: none;">
                                        Đặt trước ngay
                                    </a>
                                    <button type="button" class="btn btn-outline-light rounded-pill px-3 btn-trigger-kittybot" data-prompt="Tư vấn cho tôi về các dòng iPhone mới nhất và chương trình ưu đãi đặt trước tại KittyPhone.">
                                        Tư vấn miễn phí
                                    </button>
                                </div>
                            </div>

                            <!-- Phone Model Mockup Showcase -->
                            <div class="cps-banner-mockup-wrap">
                                <div class="cps-mockup-glow"></div>
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@(bannerIphone?.ProductId ?? 1)" title="Xem chi tiết iPhone 18 Pro Max">
                                    <img src="/images/banners/iphone_hero_banner.jpg" 
                                         alt="Mô hình iPhone 18 Pro Max và iPhone Duo" 
                                         class="cps-banner-mockup-img" />
                                </a>
                                <div class="cps-mockup-floating-badge badge-top">
                                    <i class="bi bi-shield-check text-warning me-1"></i>Titan Grade 5
                                </div>
                                <div class="cps-mockup-floating-badge badge-bottom">
                                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Trợ giá 2.5Tr
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 2: Samsung Galaxy S25 Ultra 5G -->
                    <div class="carousel-item h-100">
                        <div class="cps-slider-banner cps-banner-slide-2 p-4 text-white">
                            <div class="cps-banner-content">
                                <span class="badge bg-warning text-dark px-3 py-1 fw-bold rounded-pill mb-2 shadow-sm">
                                    <i class="bi bi-stars me-1 text-primary"></i>GALAXY AI ĐỘT PHÁ
                                </span>
                                <h2 class="display-6 fw-bold mb-2 text-white banner-heading">
                                    Samsung Galaxy <br class="d-none d-md-inline" />S25 Ultra 5G
                                </h2>
                                <p class="text-white-50 mb-3 banner-desc">
                                    Snapdragon 8 Elite - Màn hình Dynamic AMOLED 2X chống chói - Bút S-Pen quyền năng
                                </p>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge bg-white bg-opacity-10 border border-white border-opacity-25 px-2 py-1 text-white">
                                        <i class="bi bi-lightning-charge me-1 text-warning"></i>Snapdragon 8 Elite
                                    </span>
                                    <span class="badge bg-white bg-opacity-10 border border-white border-opacity-25 px-2 py-1 text-white">
                                        <i class="bi bi-pen me-1 text-info"></i>S-Pen thông minh
                                    </span>
                                    <span class="badge bg-white bg-opacity-10 border border-white border-opacity-25 px-2 py-1 text-white">
                                        <i class="bi bi-percent me-1 text-success"></i>Trả góp 0%
                                    </span>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-controller="Home" asp-action="Detail" asp-route-id="@(bannerS25?.ProductId ?? 1)" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm">
                                        Mua ngay
                                    </a>
                                    <button type="button" class="btn btn-outline-light rounded-pill px-3 btn-trigger-kittybot" data-prompt="Tư vấn cho tôi về Samsung Galaxy S25 Ultra 5G và chương trình trả góp 0%.">
                                        Tư vấn miễn phí
                                    </button>
                                </div>
                            </div>

                            <!-- Phone Model Mockup Showcase -->
                            <div class="cps-banner-mockup-wrap">
                                <div class="cps-mockup-glow glow-gold"></div>
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@(bannerS25?.ProductId ?? 1)" title="Xem chi tiết Samsung Galaxy S25 Ultra 5G">
                                    <img src="/images/banners/galaxy_s25_banner.jpg" 
                                         alt="Mô hình Samsung Galaxy S25 Ultra 5G" 
                                         class="cps-banner-mockup-img" />
                                </a>
                                <div class="cps-mockup-floating-badge badge-top">
                                    <i class="bi bi-stars text-info me-1"></i>Galaxy AI 2026
                                </div>
                                <div class="cps-mockup-floating-badge badge-bottom">
                                    <i class="bi bi-cash-stack text-success me-1"></i>Thu cũ trợ giá 2.5Tr
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#cpsMainCarousel" data-bs-slide="prev" aria-label="Lùi lại" title="Lùi lại slide trước">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#cpsMainCarousel" data-bs-slide="next" aria-label="Xem tiếp" title="Chuyển sang slide tiếp theo">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        <!-- Right: 3 Stack Promo Banners with Thumbnail Mockups -->
        <div class="cps-hero-side-banners d-none d-xl-flex flex-column gap-2">
            <button type="button" class="cps-side-card" data-bs-toggle="modal" data-bs-target="#modalPreorderIphone">
                <div class="cps-side-card-inner d-flex align-items-center justify-content-between">
                    <div>
                        <span class="cps-side-tag text-danger"><i class="bi bi-clock-history me-1"></i>HẸN SAO - GIAO VẬY</span>
                        <h6 class="fw-bold text-dark mb-1">Đặt cọc iPhone Duo &amp; 18 Pro</h6>
                        <p class="small text-muted mb-0">Lên đời trợ giá 2.5Tr hoặc tặng AirPods 4</p>
                    </div>
                    <img src="/images/banners/iphone_hero_banner.jpg" alt="iPhone 18 Pro &amp; Duo" class="cps-side-card-img" />
                </div>
            </button>
            <button type="button" class="cps-side-card" data-bs-toggle="modal" data-bs-target="#modalTradeIn">
                <div class="cps-side-card-inner d-flex align-items-center justify-content-between">
                    <div>
                        <span class="cps-side-tag text-primary"><i class="bi bi-arrow-repeat me-1"></i>THU CŨ LÊN ĐỜI</span>
                        <h6 class="fw-bold text-dark mb-1">Đổi máy cũ - Lấy máy mới</h6>
                        <p class="small text-muted mb-0">Không lo bù tiền, định giá máy trong 5 phút</p>
                    </div>
                    <img src="/images/banners/galaxy_s25_banner.jpg" alt="Thu cũ đổi mới" class="cps-side-card-img" />
                </div>
            </button>
            <button type="button" class="cps-side-card" data-bs-toggle="modal" data-bs-target="#modalWarrantyPolicy">
                <div class="cps-side-card-inner d-flex align-items-center justify-content-between">
                    <div>
                        <span class="cps-side-tag text-success"><i class="bi bi-shield-check me-1"></i>CHÍNH HÃNG 100%</span>
                        <h6 class="fw-bold text-dark mb-1">Bảo hành 1 đổi 1 30 ngày</h6>
                        <p class="small text-muted mb-0">Xuất hóa đơn VAT điện tử đầy đủ</p>
                    </div>
                    <img src="https://24hstore.vn/images/products/2026/09/10/large/iphone-18-pro-max-do_1788994643.jpg" alt="Chính hãng 100%" class="cps-side-card-img" onerror="this.onerror=null;this.src='/images/banners/iphone_hero_banner.jpg';" />
                </div>
            </button>
        </div>
    </div>

    <!-- ========================================================
         2. HIGHLIGHT 1: FESTIVAL HOT SALE STAGE (BLUE EDITION)
         ======================================================== -->
    <section class="cps-festival-stage mb-4" id="dealChongDeal">
        <!-- Stage Header: Pill Category Tabs & 4-Digit Realtime Countdown -->
        <div class="cps-stage-header">
            <div class="cps-stage-tabs" id="stageTabsList">
                <button type="button" class="cps-stage-pill active" data-stage-filter="phone">
                    <i class="bi bi-phone"></i> ĐIỆN THOẠI, ĐỒNG HỒ
                </button>
                <button type="button" class="cps-stage-pill" data-stage-filter="tablet">
                    <i class="bi bi-tablet"></i> MÁY TÍNH BẢNG, LAPTOP
                </button>
                <button type="button" class="cps-stage-pill" data-stage-filter="sound">
                    <i class="bi bi-headphones"></i> ÂM THANH, PHỤ KIỆN
                </button>
                <button type="button" class="cps-stage-pill" data-stage-filter="apple">
                    <i class="bi bi-apple"></i> APPLE CHÍNH HÃNG
                </button>
            </div>

            <!-- Countdown 4 Flip Digits (Ngày : Giờ : Phút : Giây) -->
            <div class="cps-stage-countdown-wrap">
                <span class="cps-countdown-label">
                    <i class="bi bi-alarm-fill" style="color: #66ccff;"></i> KẾT THÚC SAU
                </span>
                <div class="cps-digit-box">
                    <span class="cps-digit-item" id="stageCdDay" title="Ngày">01</span>
                    <span class="cps-digit-sep">:</span>
                    <span class="cps-digit-item" id="stageCdHour" title="Giờ">20</span>
                    <span class="cps-digit-sep">:</span>
                    <span class="cps-digit-item" id="stageCdMin" title="Phút">59</span>
                    <span class="cps-digit-sep">:</span>
                    <span class="cps-digit-item" id="stageCdSec" title="Giây">40</span>
                </div>
            </div>
        </div>

        <!-- Stage Slider Carousel Track -->
        <div class="cps-stage-slider-wrap position-relative">
            <button type="button" class="cps-stage-nav-btn cps-stage-nav-prev" onclick="scrollStageSlider(-1)" aria-label="Lùi lại">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button type="button" class="cps-stage-nav-btn cps-stage-nav-next" onclick="scrollStageSlider(1)" aria-label="Xem tiếp">
                <i class="bi bi-chevron-right"></i>
            </button>

            <div class="cps-stage-slider-track" id="stageSliderTrack">
                @foreach (var p in stageProducts)
                {
                    var tagsList = new List<string>();
                    bool isPhone = (p.CategoryId == 1 || p.CategoryId == 4);
                    bool isTablet = (p.CategoryId == 2);
                    bool isSound = (p.CategoryId == 3 || p.CategoryId == 5);
                    bool isApple = (p.ProductName != null && (p.ProductName.Contains("iPhone", StringComparison.OrdinalIgnoreCase) || 
                                   p.ProductName.Contains("iPad", StringComparison.OrdinalIgnoreCase) || 
                                   p.ProductName.Contains("Apple", StringComparison.OrdinalIgnoreCase) || 
                                   p.ProductName.Contains("AirPods", StringComparison.OrdinalIgnoreCase))) ||
                                   (p.BrandName != null && p.BrandName.Contains("Apple", StringComparison.OrdinalIgnoreCase));

                    if (isPhone) tagsList.Add("phone");
                    if (isTablet) tagsList.Add("tablet");
                    if (isSound) tagsList.Add("sound");
                    if (isApple) tagsList.Add("apple");
                    var dataTags = string.Join(" ", tagsList);
                    var initialDisplay = isPhone ? "" : "display: none;";

                    <div class="cps-stage-card-col stage-filter-item" data-tags="@dataTags" style="@initialDisplay">
                        <div class="product-card-cps h-100">
                            <!-- Top Discount Badge -->
                            <div class="cps-badge-top-row">
                                <span class="cps-badge-discount">
                                    Giảm @(p.DiscountPercent > 0 ? p.DiscountPercent : 16)%
                                </span>
                                <span class="cps-badge-installment">
                                    Trả góp 0%
                                </span>
                            </div>

                            <!-- Product Image -->
                            <div class="cps-card-img-wrap text-center">
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@p.ProductId">
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/placeholder-phone.svg" : p.ImageUrl)" 
                                         alt="@p.ProductName" 
                                         class="cps-card-img" 
                                         loading="lazy" 
                                         onerror="this.onerror=null;this.src='/images/placeholder-phone.svg';" />
                                </a>
                            </div>

                            <!-- Deal Ribbon -->
                            <div class="cps-deal-2010-ribbon">
                                <span class="cps-ribbon-text">
                                    <i class="bi bi-stars me-1 text-primary"></i>Deal Siêu Hot
                                </span>
                                <span class="cps-ribbon-sub">Giảm đến 50%</span>
                            </div>

                            <!-- Title -->
                            <h3 class="cps-card-title">
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@p.ProductId" title="@p.ProductName">
                                    @p.ProductName
                                </a>
                            </h3>

                            <!-- Price Section -->
                            <div class="cps-card-price-row">
                                <span class="cps-card-price-current">@p.SellingPrice.ToString("N0")đ</span>
                                <span class="cps-card-price-old">@((p.SellingPrice + (p.DiscountAmount > 0 ? p.DiscountAmount : p.SellingPrice * 0.15m)).ToString("N0"))đ</span>
                            </div>

                            <!-- KittyMember & Promo Box -->
                            <div class="cps-card-promo-box">
                                <i class="bi bi-gift-fill text-primary me-1"></i>KittyMember giảm thêm <strong>1%</strong> - Thu cũ đổi mới trợ giá 2.5Tr
                            </div>

                            <!-- Footer: 2 Giờ delivery + Star + Wishlist Heart -->
                            <div class="cps-card-footer">
                                <div class="d-flex align-items-center">
                                    <span class="cps-badge-speed">
                                        <i class="bi bi-clock-history"></i> 2 Giờ
                                    </span>
                                    <span class="cps-rating-star">
                                        ★ 5.0
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@p.ProductId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="cps-cart-add-btn" title="Thêm vào giỏ">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="cps-wishlist-btn" title="Thêm vào yêu thích" onclick="$(this).toggleClass('text-danger active');">
                                        <i class="bi bi-heart"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ========================================================
         2.1. HIGHLIGHT 2: CELLPHONES-STYLE "GỢI Ý CHO BẠN" (RECOMMENDATIONS + TREND TABS)
         ======================================================== -->
    <section class="cps-foryou-container mb-4 position-relative">
