    <!-- ========================================================
         2.5. SECTION "KHUYẾN MÃI & VOUCHER ĐẶC BIỆT KITTYPHONE"
         (Trích xuất dữ liệu trực tiếp từ bảng Promotion CSDL)
         ======================================================== -->
    @if (promotions.Count > 0)
    {
        <section class="cps-promo-section mb-4 p-3 p-md-4 rounded-3 border shadow-sm" style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border-color: #bae6fd !important;">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger text-white px-2 py-1 fs-6 rounded-pill"><i class="bi bi-tag-fill me-1"></i>VOUCHER HOT</span>
                    <h4 class="fw-bold mb-0 text-dark">Chương Trình Khuyến Mãi & Giảm Giá</h4>
                </div>
                <span class="text-muted small">Tự động áp dụng tại bước thanh toán khi đặt mua online</span>
            </div>

            <div class="row g-3">
                @foreach (var promo in promotions)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="bg-white p-3 rounded-3 border h-100 d-flex flex-column justify-content-between position-relative shadow-sm" style="border-left: 5px solid var(--brand-blue) !important;">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2 gap-1 flex-wrap">
                                    <span class="badge bg-primary text-white fw-bold px-2 py-1" style="font-size: 11px;">
                                        <i class="bi bi-percent me-1"></i>GIẢM @promo.DiscountPercent.ToString("0.#")%
                                    </span>

                                    @if (promo.StartHour.HasValue && promo.EndHour.HasValue)
                                    {
                                        if (promo.IsInActiveHour)
                                        {
                                            <span class="badge bg-danger text-white fw-bold px-2 py-1 rounded-pill animate__animated animate__pulse animate__infinite" style="font-size: 10px;">
                                                <i class="bi bi-lightning-fill me-1"></i>Đang trong Giờ Vàng!
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill" style="font-size: 10px;">
                                                <i class="bi bi-clock me-1"></i>Khung @(promo.StartHour):00 - @(promo.EndHour):00
                                            </span>
                                        }
                                    }
                                    else if (promo.MinRankId.HasValue && promo.MinRankId > 1)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill" style="font-size: 10px;">
                                            <i class="bi bi-patch-check-fill text-warning me-1"></i>Hội viên Bạc / Vàng
                                        </span>
                                    }
                                    else if (promo.StartDate.Date == promo.EndDate.Date)
                                    {
                                        <span class="badge bg-info-subtle text-primary border border-info-subtle rounded-pill" style="font-size: 10px;">
                                            <i class="bi bi-calendar-event me-1"></i>Duy nhất 20/10
                                        </span>
                                    }
                                    else if (promo.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 10px;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đang diễn ra (3 ngày)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill" style="font-size: 10px;">
                                            Sắp diễn ra
                                        </span>
                                    }
                                </div>
                                <h6 class="fw-bold text-dark mb-1" style="font-size: 14px; line-height: 1.3;">@promo.PromotionName</h6>
                                <p class="text-muted small mb-2" style="font-size: 12px; line-height: 1.4;">@promo.Description</p>
                            </div>
                            <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted" style="font-size: 11px;">
                                    @if (promo.StartDate.Date == promo.EndDate.Date)
                                    {
                                        <i class="bi bi-calendar-check text-primary me-1"></i><span>Ngày: 20/10/2026</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-calendar-range text-muted me-1"></i><span>@promo.StartDate.ToString("dd/MM") - @promo.EndDate.ToString("dd/MM/yyyy")</span>
                                    }
                                </span>
                                @if ((promo.MinRankId.HasValue && promo.MinRankId > 1) || promo.PromotionName.Contains("Hội viên") || promo.PromotionName.Contains("KittyMember"))
                                {
                                    <a href="@Url.Action("Profile", "Customer")" class="btn btn-sm btn-primary text-white fw-bold px-2 py-1 btn-kitty-member-privilege" style="font-size: 11px;" data-bs-toggle="modal" data-bs-target="#modalKittyMemberPrivileges" title="Xem đặc quyền thành viên KittyMember">
                                        <i class="bi bi-patch-check-fill me-1"></i>Xem đặc quyền hội viên
                                    </a>
                                }
                                else
                                {
                                    <a href="#productCatalog" class="btn btn-sm btn-outline-primary fw-bold px-2 py-1" style="font-size: 11px;">
                                        Mua ngay
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
    }

    <!-- ========================================================
         2.6. SECTION FLASH SALE GIỜ VÀNG (COUNTDOWN TIMER)
         ======================================================== -->
    <section class="mb-4 rounded-4 shadow-sm overflow-hidden border border-danger border-opacity-25" style="background: linear-gradient(135deg, #7f1d1d 0%, #dc2626 50%, #ea580c 100%);">
        <div class="p-3 p-md-4 text-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-3"><i class="bi bi-lightning-charge-fill text-warning"></i></span>
                    <div>
                        <h4 class="fw-bold mb-0 text-white text-uppercase" style="letter-spacing: 0.5px;">🔥 FLASH SALE GIỜ VÀNG</h4>
                        <span class="text-white-50 small">Số lượng có hạn - Giảm giá chớp nhoáng duy nhất hôm nay</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 bg-black bg-opacity-25 px-3 py-2 rounded-pill border border-white border-opacity-25">
                    <span class="small text-white-50 fw-semibold text-uppercase me-1"><i class="bi bi-stopwatch text-warning me-1"></i>Kết thúc trong:</span>
                    <div class="d-flex gap-1 fw-bold fs-6" id="flashSaleTimer">
                        <span class="badge bg-dark text-white rounded px-2 py-1 timer-hours">02</span> :
                        <span class="badge bg-dark text-white rounded px-2 py-1 timer-minutes">45</span> :
                        <span class="badge bg-dark text-white rounded px-2 py-1 timer-seconds">30</span>
                    </div>
                </div>
            </div>

            <!-- Flash Sale Items -->
            <div class="row row-cols-2 row-cols-md-4 g-3">
                @foreach (var item in Model.Where(p => p.Quantity > 0).Take(4))
                {
                    decimal flashPrice = Math.Round(item.SellingPrice * 0.82m, 0);
                    <div class="col">
                        <div class="bg-white rounded-3 p-3 h-100 text-dark d-flex flex-column justify-content-between position-relative shadow-sm">
                            <span class="badge bg-danger position-absolute top-0 start-0 m-2 rounded-pill px-2 py-1 shadow-sm" style="font-size: 11px;">
                                <i class="bi bi-fire me-1"></i>-18% GIẢM SỐC
                            </span>
                            <div class="text-center pt-3 mb-2">
                                <a asp-action="Detail" asp-route-id="@item.ProductId" class="text-decoration-none">
                                    <img src="@(item.ImageUrl ?? "/images/placeholder-phone.svg")" alt="@item.ProductName" class="img-fluid" style="max-height: 130px; object-fit: contain;" />
                                </a>
                            </div>
                            <div>
                                <a asp-action="Detail" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">
                                    <div class="fw-bold small text-truncate-2 mb-1" style="height: 38px; line-height: 1.3;" title="@item.ProductName">@item.ProductName</div>
                                </a>
                                <div class="d-flex align-items-baseline gap-2 mb-2">
                                    <span class="fw-bold text-danger fs-6">@flashPrice.ToString("N0")đ</span>
                                    <span class="text-muted small text-decoration-line-through" style="font-size: 11px;">@item.SellingPrice.ToString("N0")đ</span>
                                </div>
                                <div class="mb-3">
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" style="width: 78%;"></div>
                                    </div>
                                    <span class="text-muted" style="font-size: 10px;">Đã bán 78/100 máy</span>
                                </div>
                                <a href="@Url.Action("Detail", "Home", new { id = item.ProductId })" class="btn btn-sm btn-danger w-100 rounded-pill fw-bold shadow-sm btn-san-deal" data-product-id="@item.ProductId" title="Săn Deal ngay - Xem chi tiết @item.ProductName">
                                    <i class="bi bi-lightning-charge-fill me-1"></i>Săn Deal Ngay
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

