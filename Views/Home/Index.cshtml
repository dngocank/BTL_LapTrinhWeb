                                <option value="15000000">iPhone 14 Pro Max 128GB</option>
                                <option value="10500000">iPhone 13 128GB</option>
                                <option value="18000000">Samsung Galaxy S24 Ultra</option>
                                <option value="14000000">Samsung Galaxy S23 Ultra</option>
                                <option value="16000000">iPad Pro M2 11 inch</option>
