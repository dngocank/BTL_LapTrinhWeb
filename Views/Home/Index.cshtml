                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted small">Trợ giá thêm KittyPhone:</div>
                                <strong class="text-success fs-6"><i class="bi bi-plus-circle me-1"></i>2.500.000đ</strong>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted small">Tổng tiền khấu trừ:</div>
                                <strong class="text-primary fs-5" id="tradeTotalDeduct">24.000.000đ</strong>
                            </div>
                            <div class="col-6 col-md-3 text-md-end">
                                <div class="text-muted small">Số tiền thực tế chỉ cần bù:</div>
                                <span class="text-danger fw-bold fs-4 d-block" id="tradePayMore">17.990.000đ</span>
                                <span class="badge bg-danger-subtle text-danger" style="font-size: 11px;">Hoặc góp 0% chỉ ~1.5Tr/tháng</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top Eligible Devices -->
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-fire text-danger me-1"></i>Top sản phẩm áp dụng trợ giá 2.500.000đ hot nhất</h6>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3 mb-4">
                    @if (tradeInProducts.Any())
                    {
                        foreach (var tip in tradeInProducts.Take(4))
                        {
                            <div class="col">
                                <div class="card h-100 border-0 shadow-sm rounded-3 p-3 text-center bg-white">
                                    <img src="@(string.IsNullOrEmpty(tip.ImageUrl) ? "/images/placeholder-phone.svg" : tip.ImageUrl)" 
                                         alt="@tip.ProductName" 
                                         class="mx-auto mb-2 img-fluid" 
                                         style="height: 100px; object-fit: contain;" 
                                         onerror="this.onerror=null;this.src='/images/placeholder-phone.svg';" />
                                    <h6 class="fw-bold small text-truncate mb-1" title="@tip.ProductName">@tip.ProductName</h6>
                                    <div class="text-danger fw-bold small mb-1">@tip.SellingPrice.ToString("N0")đ</div>
                                    <span class="badge bg-success-subtle text-success small mb-2">Trợ giá 2.5Tr</span>
                                    <a asp-controller="Home" asp-action="Detail" asp-route-id="@tip.ProductId" class="btn btn-sm btn-outline-primary rounded-pill mt-auto">
                                        Lên đời máy này
                                    </a>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- 3 Steps Process -->
                <div class="p-3 bg-white rounded-3 border">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-check2-circle text-success me-1"></i>Quy trình thu cũ đổi mới đơn giản 3 bước:</h6>
                    <div class="row g-2 small text-muted">
                        <div class="col-md-4">
                            <span class="badge bg-primary me-1">1</span> <strong>Khảo sát &amp; Định giá:</strong> Chọn dòng máy và nhận báo giá online ngay lập tức.
                        </div>
                        <div class="col-md-4">
