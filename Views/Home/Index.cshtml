                        <i class="bi bi-check-circle-fill me-1"></i>Cảm ơn bạn đã bình chọn! Mã Voucher giảm 500k của bạn là: <strong>FLAGSHIP500</strong>
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================
         3. SECTION "DANH MỤC THIẾT BỊ CÔNG NGHỆ CHÍNH HÃNG"
         ======================================================== -->
    <div id="productCatalog" class="pt-2">
        <!-- Section Header -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
                <h4 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-grid-3x3-gap-fill text-danger me-2"></i>@categoryTitle
                </h4>
                <span class="text-muted small">Cam kết hàng chính hãng 100% VN/A - Bảo hành 12 tháng tại các trung tâm ủy quyền toàn quốc</span>
            </div>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fs-6 fw-bold">
                @Model.Count sản phẩm sẵn hàng
            </span>
        </div>

        <!-- 5 Category Filter Tabs -->
        <div class="cps-category-tabs mb-3">
            <a asp-action="Index" 
               asp-route-sort="@currentSort" 
               class="cps-tab-btn @(currentCategoryId == null && string.IsNullOrEmpty(currentSeries) && string.IsNullOrEmpty(currentKeyword) ? "active" : "")">
                <i class="bi bi-grid-fill"></i> Tất cả
            </a>
            <a asp-action="Index" 
               asp-route-categoryId="1" 
               asp-route-sort="@currentSort" 
               class="cps-tab-btn @(currentCategoryId == 1 ? "active" : "")">
                <i class="bi bi-phone"></i> Điện thoại
            </a>
            <a asp-action="Index" 
               asp-route-categoryId="2" 
               asp-route-sort="@currentSort" 
               class="cps-tab-btn @(currentCategoryId == 2 ? "active" : "")">
                <i class="bi bi-tablet"></i> Máy tính bảng
            </a>
            <a asp-action="Index" 
               asp-route-categoryId="4" 
               asp-route-sort="@currentSort" 
               class="cps-tab-btn @(currentCategoryId == 4 ? "active" : "")">
                <i class="bi bi-smartwatch"></i> Đồng hồ thông minh
            </a>
            <a asp-action="Index" 
               asp-route-categoryId="3" 
               asp-route-sort="@currentSort" 
               class="cps-tab-btn @(currentCategoryId == 3 ? "active" : "")">
                <i class="bi bi-headphones"></i> Tai nghe & Phụ kiện
            </a>
        </div>

        <!-- Quick Series Filter Pills (Biến thể riêng biệt theo danh mục) -->
        <div class="cps-series-filter-scroll mb-3">
            <a asp-action="Index" 
               asp-route-categoryId="@currentCategoryId" 
               asp-route-priceRange="@currentPriceRange" 
               asp-route-sort="@currentSort" 
               class="cps-series-pill @(string.IsNullOrEmpty(currentSeries) && string.IsNullOrEmpty(currentKeyword) ? "active" : "")">
                @currentFilterConfig.AllLabel
            </a>
            @foreach (var sub in currentFilterConfig.Items)
            {
                <a asp-action="Index" 
                   asp-route-series="@sub.Query" 
                   asp-route-categoryId="@currentCategoryId" 
                   asp-route-priceRange="@currentPriceRange" 
                   asp-route-sort="@currentSort" 
                   class="cps-series-pill @(currentSeries == sub.Query ? "active" : "")">
                    @sub.Label
                </a>
            }
        </div>

        <!-- Price Range & Sort Bar -->
        <div class="cps-filter-sort-bar mb-4">
            <!-- Price Filters -->
            <div class="cps-price-filters">
                <span class="cps-filter-label"><i class="bi bi-funnel me-1 text-danger"></i>Mức giá:</span>
                <a asp-action="Index" 
                   asp-route-series="@currentSeries" 
                   asp-route-categoryId="@currentCategoryId" 
                   asp-route-sort="@currentSort" 
                   class="cps-filter-chip @(string.IsNullOrEmpty(currentPriceRange) ? "active" : "")">
                    Tất cả
                </a>
                <a asp-action="Index" 
                   asp-route-priceRange="lt10" 
                   asp-route-series="@currentSeries" 
                   asp-route-categoryId="@currentCategoryId" 
                   asp-route-sort="@currentSort" 
                   class="cps-filter-chip @(currentPriceRange == "lt10" ? "active" : "")">
                    Dưới 10 triệu
                </a>
                <a asp-action="Index" 
                   asp-route-priceRange="10to20" 
                   asp-route-series="@currentSeries" 
                   asp-route-categoryId="@currentCategoryId" 
                   asp-route-sort="@currentSort" 
                   class="cps-filter-chip @(currentPriceRange == "10to20" ? "active" : "")">
                    10 - 20 triệu
                </a>
                <a asp-action="Index" 
                   asp-route-priceRange="gt20" 
                   asp-route-series="@currentSeries" 
                   asp-route-categoryId="@currentCategoryId" 
                   asp-route-sort="@currentSort" 
                   class="cps-filter-chip @(currentPriceRange == "gt20" ? "active" : "")">
                    Trên 20 triệu
                </a>
            </div>

            <!-- Sort Group -->
            <div class="cps-sort-group">
                <span class="cps-filter-label"><i class="bi bi-arrow-down-up me-1 text-danger"></i>Sắp xếp:</span>
                <a asp-action="Index" 
                   asp-route-sort="hot" 
                   asp-route-series="@currentSeries" 
                   asp-route-categoryId="@currentCategoryId" 
                   asp-route-priceRange="@currentPriceRange" 
                   class="cps-sort-chip @(currentSort == "hot" ? "active" : "")">
                    Nổi bật
                </a>
                <a asp-action="Index" 
                   asp-route-sort="discount" 
                   asp-route-series="@currentSeries" 
                   asp-route-categoryId="@currentCategoryId" 
                   asp-route-priceRange="@currentPriceRange" 
                   class="cps-sort-chip @(currentSort == "discount" ? "active" : "")">
                    % Giảm nhiều
                </a>
                <a asp-action="Index" 
                   asp-route-sort="asc" 
                   asp-route-series="@currentSeries" 
                   asp-route-categoryId="@currentCategoryId" 
                   asp-route-priceRange="@currentPriceRange" 
                   class="cps-sort-chip @(currentSort == "asc" ? "active" : "")">
                    Giá thấp - cao
                </a>
                <a asp-action="Index" 
                   asp-route-sort="desc" 
                   asp-route-series="@currentSeries" 
                   asp-route-categoryId="@currentCategoryId" 
                   asp-route-priceRange="@currentPriceRange" 
                   class="cps-sort-chip @(currentSort == "desc" ? "active" : "")">
                    Giá cao - thấp
                </a>
            </div>
        </div>

        <!-- Product Grid -->
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 bg-white rounded-3 border my-4 shadow-sm">
                <i class="bi bi-search display-3 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold">Không tìm thấy sản phẩm phù hợp</h5>
                <p class="text-muted">Rất tiếc, không có sản phẩm nào khớp với tiêu chí tìm kiếm hoặc bộ lọc của bạn.</p>
                <a asp-action="Index" class="btn btn-danger rounded-pill px-4 fw-bold">
                    <i class="bi bi-arrow-clockwise me-1"></i>Xem tất cả sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 mb-5">
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="product-card-cps">
                            <!-- Top Discount Badge -->
                            <div class="cps-badge-top-row">
                                <span class="cps-badge-discount">
                                    Giảm @(item.DiscountPercent > 0 ? item.DiscountPercent : 15)%
                                </span>
                                <span class="cps-badge-installment">
                                    Trả góp 0%
                                </span>
                            </div>

                            <!-- Product Image -->
                            <div class="cps-card-img-wrap text-center">
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.ProductId">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder-phone.svg" : item.ImageUrl)" 
                                         alt="@item.ProductName" 
                                         class="cps-card-img" 
                                         loading="lazy" 
                                         onerror="this.onerror=null;this.src='/images/placeholder-phone.svg';" />
                                </a>
                            </div>

                            <!-- Title -->
                            <h3 class="cps-card-title">
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.ProductId" title="@item.ProductName">
                                    @item.ProductName
                                </a>
                            </h3>

                            <!-- Price Section -->
                            <div class="cps-card-price-row">
                                <span class="cps-card-price-current">@item.SellingPrice.ToString("N0")đ</span>
                                <span class="cps-card-price-old">@((item.SellingPrice + item.DiscountAmount).ToString("N0"))đ</span>
                            </div>

                            <!-- KittyMember & Promo Box -->
                            <div class="cps-card-promo-box">
                                <i class="bi bi-gift-fill text-primary me-1"></i>KittyMember giảm thêm đến <strong>1%</strong> - Thu cũ đổi mới trợ giá 2.5Tr
                            </div>

                            <!-- Footer: 2 Giờ delivery + Star + Actions -->
                            <div class="cps-card-footer">
                                <div class="d-flex align-items-center">
                                    <span class="cps-badge-speed">
                                        <i class="bi bi-clock-history"></i> 2 Giờ
                                    </span>
                                    <span class="cps-rating-star">
                                        ★ 5.0
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="cps-cart-add-btn" title="Thêm vào giỏ">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="cps-wishlist-btn" title="Yêu thích" onclick="$(this).toggleClass('text-danger active');">
                                        <i class="bi bi-heart"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

