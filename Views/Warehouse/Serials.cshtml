@model List<BTL_PTTKYC.Models.ProductSerialModel>
@{
    ViewData["Title"] = "Quản Lý IMEI & Serial Number";
    Layout = "_AdminLayout";
    var products = ViewBag.Products as List<BTL_PTTKYC.Models.ProductViewModel> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-upc-scan text-danger me-2"></i>Quản Lý Mã Máy (IMEI & Serial Number)</h4>
        <span class="text-muted small">Định danh từng thiết bị vật lý để kích hoạt bảo hành điện tử chính hãng</span>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="DownloadSerialTemplate" class="btn btn-outline-secondary rounded-pill btn-sm fw-semibold">
            <i class="bi bi-download me-1"></i>Tải Mẫu CSV
        </a>
        <button type="button" class="btn btn-outline-success rounded-pill btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#importCsvModal">
            <i class="bi bi-file-earmark-excel me-1"></i>Import Excel/CSV
        </button>
        <a asp-action="ExportSerialsCsv" class="btn btn-outline-primary rounded-pill btn-sm fw-semibold">
            <i class="bi bi-box-arrow-up-right me-1"></i>Xuất Excel/CSV
        </a>
        <button type="button" class="btn btn-danger rounded-pill px-3 btn-sm fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addSerialModal">
            <i class="bi bi-plus-lg me-1"></i>Thêm Thủ Công
        </button>
    </div>
</div>

<!-- Serials Table -->
<div class="bg-white rounded-3 border shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Số IMEI</th>
                    <th>Số Serial</th>
                    <th>Kho Chứa</th>
                    <th>Tình Trạng Thiết Bị</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            Chưa có dữ liệu IMEI / Serial trong kho.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="text-muted fw-bold">#@s.SerialId</td>
                            <td><strong class="text-dark">@s.ProductName</strong></td>
                            <td><code>@(s.ImeiNumber ?? "N/A")</code></td>
                            <td><code>@(s.SerialNumber ?? "N/A")</code></td>
                            <td><span class="badge bg-light text-dark border">@s.WarehouseName</span></td>
                            <td>
                                @if (s.Status == "In Stock")
                                {
                                    <span class="badge bg-success-subtle text-success">Trong kho (In Stock)</span>
                                }
                                else if (s.Status == "Sold")
                                {
                                    <span class="badge bg-primary-subtle text-primary">Đã bán (Sold)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">@s.Status</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Add Serial -->
<div class="modal fade" id="addSerialModal" tabindex="-1" aria-labelledby="addSerialModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="AddSerial" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addSerialModalLabel">
                        <i class="bi bi-upc-scan me-2 text-danger"></i>Ghi Nhận Mã Máy (IMEI / Serial)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sản phẩm <span class="text-danger">*</span></label>
                        <select name="productId" class="form-select" required>
                            @foreach (var p in products)
                            {
                                <option value="@p.ProductId">@p.ProductName (@p.BrandName)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã IMEI (15 số)</label>
                        <input type="text" name="imeiNumber" class="form-control" placeholder="Ví dụ: 356789123456789" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Serial Number</label>
                        <input type="text" name="serialNumber" class="form-control" placeholder="Ví dụ: APL-IP15PM-005" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kho lưu trữ</label>
                        <select name="warehouseId" class="form-select">
                            <option value="1">Kho chính TP.HCM (Main Warehouse)</option>
                            <option value="2">Kho Hà Nội (North Warehouse)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Lưu Mã Máy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Import Batch IMEI / Serial via CSV (Feature 7) -->
<div class="modal fade" id="importCsvModal" tabindex="-1" aria-labelledby="importCsvModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="ImportSerialsCsv" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="importCsvModalLabel">
                        <i class="bi bi-file-earmark-spreadsheet me-2"></i>Nhập Danh Sách IMEI Hàng Loạt
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i>Hệ thống chấp nhận file <strong>.csv</strong> hoặc <strong>.txt</strong> chứa 3 cột: <code>ProductId, IMEI, SerialNumber</code>.
                        <div class="mt-1">
                            <a asp-action="DownloadSerialTemplate" class="fw-bold text-primary">Bấm vào đây để tải file CSV mẫu</a>.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn kho đích lưu máy <span class="text-danger">*</span></label>
                        <select name="warehouseId" class="form-select">
                            <option value="1">Kho chính TP.HCM (Main Warehouse)</option>
                            <option value="2">Kho Hà Nội (North Warehouse)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn file CSV từ máy tính <span class="text-danger">*</span></label>
                        <input type="file" name="csvFile" class="form-control" accept=".csv,text/csv,text/plain" required />
                        <div class="form-text small">Dung lượng tối đa 5MB. Mỗi dòng tương ứng với 1 thiết bị.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-upload me-1"></i>Bắt Đầu Import
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
